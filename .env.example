# Saboot Environment Configuration Example
# Copy this file to .env and configure your secrets locally.
# NEVER commit .env or expose credentials to client bundles.

OPEN_SOURCE_AI_API_KEY=
OPEN_SOURCE_AI_BASE_URL=https://api.groq.com/openai/v1
OPEN_SOURCE_AI_MODEL=llama-3.1-8b-instant
SABOOT_ATTESTATION_SECRET=saboot-zero-trust-secret-key-production
PORT=3001
EXPO_PUBLIC_ADMIN_PORT=3001

# Customer email notifications
# demo = zero-cost local simulation
# resend = real transactional email provider
EMAIL_PROVIDER=demo

RESEND_API_KEY=
EMAIL_FROM=

# Customer verification portal
CUSTOMER_PORTAL_BASE_URL=http://localhost:3001
