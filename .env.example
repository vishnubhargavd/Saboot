# Saboot Environment Configuration Example
# Copy this file to .env and configure your secrets locally.
# NEVER commit .env or expose credentials to client bundles.

OPEN_SOURCE_AI_API_KEY=
OPEN_SOURCE_AI_BASE_URL=https://api.groq.com/openai/v1
OPEN_SOURCE_AI_MODEL=llama-3.1-8b-instant
SABOOT_ATTESTATION_SECRET=saboot-zero-trust-secret-key-production
PORT=3001
EXPO_PUBLIC_ADMIN_PORT=3001

# Customer email notifications
# demo = zero-cost local simulation
# resend = real transactional email provider
EMAIL_PROVIDER=demo

RESEND_API_KEY=
EMAIL_FROM=

# Backend API used by Mobile Driver Expo App
# Local LAN example: http://192.168.1.105:3001
# Production example: https://api.saboot.example.com
EXPO_PUBLIC_BACKEND_URL=http://YOUR_LAN_IP:3001

# Customer-facing base URL embedded into QR codes (scanned by customer phone)
# Local LAN example: http://192.168.1.105:3001
# Production example: https://verify.saboot.example.com
PUBLIC_BASE_URL=http://YOUR_LAN_IP:3001

# Legacy alias for customer verification portal
CUSTOMER_PORTAL_BASE_URL=http://YOUR_LAN_IP:3001
