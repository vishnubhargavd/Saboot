# Saboot Environment Configuration Example
# Copy this file to .env and configure your secrets locally.
# NEVER commit .env or expose credentials to client bundles.

# ==============================================================================
# PHYSICAL DEVICE LAN DEVELOPMENT QUICKSTART
# ==============================================================================
# 1. Connect laptop, Driver phone (Expo Go), and Customer phone to the SAME Wi-Fi.
# 2. Find your laptop LAN IPv4 address:
#      - Windows:  ipconfig (look for IPv4 Address under active Wi-Fi adapter)
#      - macOS:    ipconfig getifaddr en0 (or en1)
#      - Linux:    hostname -I | awk '{print $1}'
# 3. Replace YOUR_LAN_IP in EXPO_PUBLIC_BACKEND_URL and PUBLIC_BASE_URL below.
# 4. Start backend: npm run admin (or make admin).
# 5. Confirm http://<YOUR_LAN_IP>:3001/health from the customer phone browser.
# 6. Start Expo: npm start (or make expo).
# 7. Open delivery in driver app -> Tap "SHOW CUSTOMER QR".
# 8. Scan QR code using the customer phone camera to verify handoff on the real portal.
# ==============================================================================

# Server network binding (0.0.0.0 binds to all network interfaces for LAN reachability)
HOST=0.0.0.0
PORT=3001
EXPO_PUBLIC_ADMIN_PORT=3001

# Enforce non-loopback URLs for physical customer QR generation (prevents accidental localhost in QR)
PHYSICAL_DEVICE_LAN_MODE=false

# Backend API used by Mobile Driver Expo App (e.g. http://192.168.1.105:3001)
EXPO_PUBLIC_BACKEND_URL=http://YOUR_LAN_IP:3001

# Customer-facing base URL embedded into QR codes (e.g. http://192.168.1.105:3001)
PUBLIC_BASE_URL=http://YOUR_LAN_IP:3001

# Legacy alias for customer verification portal
CUSTOMER_PORTAL_BASE_URL=http://YOUR_LAN_IP:3001

# Attestation & AI explanation
SABOOT_ATTESTATION_SECRET=saboot-zero-trust-secret-key-production
OPEN_SOURCE_AI_API_KEY=
OPEN_SOURCE_AI_BASE_URL=https://api.groq.com/openai/v1
OPEN_SOURCE_AI_MODEL=llama-3.1-8b-instant

# Customer email notifications
# demo = zero-cost local simulation
# resend = real transactional email provider
EMAIL_PROVIDER=demo
RESEND_API_KEY=
EMAIL_FROM=
